{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "roots": [
    "<rootDir>/test/contract"
  ],
  "testEnvironment": "node",
  "testRegex": ".contract-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "passWithNoTests": true,
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "maxWorkers": 1,
  "testTimeout": 30000
}
