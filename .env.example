# See docs/prds/01-setup-and-structure.md §1.2. Required values are marked.

APP_URL=http://localhost:8000                # required
APP_ENV=local                                # `production` turns on the strict password policy
APP_KEY=                                     # required; `base64:` keys are decoded (php artisan key:generate --show)
PORT=8000
TZ=UTC                                       # must be UTC; the app refuses to boot otherwise

DB_TYPE=postgres                             # required: sqlite | postgres
DB_URL=postgres://forms:forms@127.0.0.1:5432/forms   # required; a file path or :memory: for sqlite
REDIS_URL=redis://127.0.0.1:6379             # required

JWT_SECRET=                                  # required
JWT_TTL=60
JWT_REFRESH_TTL=10080
BCRYPT_ROUNDS=12

PASSWORD_RESET_URL=                          # default {APP_URL}/reset-password
TRUSTED_PROXIES=127.0.0.1                    # IPs/CIDRs, or * for the calling IP only; empty trusts none
QUEUE_DRIVER=bullmq                          # bullmq | sync
BODY_LIMIT=2mb
EXPORT_DOWNLOAD_URL_TTL=5

FILESYSTEM_DISK=local
STORAGE_ROOT=storage/app/private

TYPESAFE_API_KEY=                            # optional; empty skips spam classification

MAIL_MAILER=log                              # postmark | smtp | log
MAIL_FROM_ADDRESS=hello@example.com          # required
MAIL_FROM_NAME="Headless Form Handler"
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
POSTMARK_API_KEY=                            # required when MAIL_MAILER=postmark
POSTMARK_WEBHOOK_USERNAME=                   # either empty → the bounce webhook answers 401
POSTMARK_WEBHOOK_PASSWORD=
